# Anthropic
ANTHROPIC_API_KEY=sk-ant-api03-YOUR_KEY_HERE

# Google OAuth (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret-here
GOOGLE_REDIRECT_URI=https://your-app.onrender.com/auth/callback

# Google resource IDs (filled in after first-time setup)
GOOGLE_SHEET_ID=your-sheet-id-here
GOOGLE_DRIVE_FOLDER_ID=your-drive-folder-id-here

# Google token (paste contents of token.json as a single line — used on Render)
GOOGLE_TOKEN_JSON={"token":"...","refresh_token":"...","token_uri":"...","client_id":"...","client_secret":"...","scopes":["..."]}

# App
SECRET_KEY=generate-a-long-random-string
BOARD_EMAIL=alterations@yourbuilding.com
ADMIN_EMAIL=board@yourbuilding.com
ALTERATIONS_EMAIL=alterations@yourbuilding.com
EDDIE_EMAIL=super@yourbuilding.com
ORSID_CC_EMAILS=mgmt1@management.com,mgmt2@management.com
CAPOBIANCO_EMAIL=architect@example.com
MELONE_EMAILS=architect2a@example.com,architect2b@example.com
BUILDING_NAME=Your Building Name Owners Corp.
